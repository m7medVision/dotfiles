{
  // Command menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate search-match routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "style": {"icon":"","label":"Style"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},
  "theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(theme-switcher); [[ -n $theme ]] && theme-set \"$theme\""},

  // System
  "system.lock": {"icon":"","label":"Lock","action":"system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"system-shutdown"},



  // Style
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(theme-bg-switcher); [[ -n $background ]] && theme-bg-set \"$background\""},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.bar.position.top": {"icon":"󰁝","label":"Top","action":"bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Bottom","action":"bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Left","action":"bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Right","action":"bar position right"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Keybindings","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Input","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Network","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(dns)\" == \"DHCP\" ]]","action":"dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(dns)\" == \"Cloudflare\" ]]","action":"dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(dns)\" == \"Google\" ]]","action":"dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Custom","checked":"[[ \"$(dns)\" == \"Custom\" ]]","action":"launch-floating-terminal-with-presentation 'dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR Code","aliases":["wifi-qr"],"when":"[[ $(network-status) == wifi* ]]","action":"shell-ipc-run shell summon raw.wifiqr"},
  "setup.default": {"icon":"","label":"Defaults","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Default Agent"},
  "setup.default.agent.agy": {"icon":"󰫢","label":"Antigravity","checked":"[[ \"$(default-agent)\" == \"agy\" ]]","action":"default-agent agy"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(default-agent)\" == \"claude\" ]]","action":"default-agent claude"},
  "setup.default.agent.codex": {"icon":"","label":"Codex","checked":"[[ \"$(default-agent)\" == \"codex\" ]]","action":"default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(default-agent)\" == \"copilot\" ]]","action":"default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(default-agent)\" == \"crush\" ]]","action":"default-agent crush"},
  "setup.default.agent.grok": {"icon":"","label":"Grok","checked":"[[ \"$(default-agent)\" == \"grok\" ]]","action":"default-agent grok"},
  "setup.default.agent.omp": {"icon":"","label":"omp","checked":"[[ \"$(default-agent)\" == \"omp\" ]]","action":"default-agent omp"},
  "setup.default.agent.opencode": {"icon":"","label":"OpenCode","checked":"[[ \"$(default-agent)\" == \"opencode\" ]]","action":"default-agent opencode"},
  "setup.default.agent.ori": {"icon":"","label":"Ori","checked":"[[ \"$(default-agent)\" == \"ori\" ]]","action":"default-agent ori"},
  "setup.default.agent.pi": {"icon":"","label":"Pi","checked":"[[ \"$(default-agent)\" == \"pi\" ]]","action":"default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Browser","title":"Default Browser"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","checked":"[[ \"$(default-browser)\" == \"chromium\" ]]","action":"default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","checked":"[[ \"$(default-browser)\" == \"chrome\" ]]","action":"default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","checked":"[[ \"$(default-browser)\" == \"brave\" ]]","action":"default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","checked":"[[ \"$(default-browser)\" == \"brave-origin\" ]]","action":"default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","checked":"[[ \"$(default-browser)\" == \"edge\" ]]","action":"default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","checked":"[[ \"$(default-browser)\" == \"firefox\" ]]","action":"default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","checked":"[[ \"$(default-browser)\" == \"zen\" ]]","action":"default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminal","title":"Default Terminal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","checked":"[[ \"$(default-terminal)\" == \"alacritty\" ]]","action":"default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","checked":"[[ \"$(default-terminal)\" == \"foot\" ]]","action":"default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","checked":"[[ \"$(default-terminal)\" == \"ghostty\" ]]","action":"default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","checked":"[[ \"$(default-terminal)\" == \"kitty\" ]]","action":"default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Editor","title":"Default Editor"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","checked":"[[ \"$(default-editor)\" == \"nvim\" ]]","action":"default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","checked":"[[ \"$(default-editor)\" == \"code\" ]]","action":"default-editor code"},
  "setup.default.editor.cursor": {"icon":"","label":"Cursor","checked":"[[ \"$(default-editor)\" == \"cursor\" ]]","action":"default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","checked":"[[ \"$(default-editor)\" == \"zeditor\" ]]","action":"default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","checked":"[[ \"$(default-editor)\" == \"sublime_text\" ]]","action":"default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","checked":"[[ \"$(default-editor)\" == \"helix\" ]]","action":"default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","checked":"[[ \"$(default-editor)\" == \"vim\" ]]","action":"default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","checked":"[[ \"$(default-editor)\" == \"emacs\" ]]","action":"default-editor emacs"},
  "setup.security": {"icon":"","label":"Security"},
  "setup.config": {"icon":"","label":"Config"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"hw-fingerprint","action":"launch-floating-terminal-with-presentation setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"launch-floating-terminal-with-presentation setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"launch-floating-terminal-with-presentation setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Passwordless Sudo","action":"launch-floating-terminal-with-presentation sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"sudo-docker --configured","action":"launch-floating-terminal-with-presentation setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"launch-config-editor ~/.config/hypr/hyprsunset.conf && restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"launch-config-editor ~/.XCompose && restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direct Boot","action":"launch-floating-terminal-with-presentation setup-direct-boot"},

}
